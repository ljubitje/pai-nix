+#!/usr/bin/env bun
+/**
+ * @version 3.0.0
+ * PrivateZones — data classification for archive sweeps and tool reads.
+ *
+ * INVARIANT: private zones are COUNTED, never QUOTED.
+ *
+ * Archive probes run over `~/.claude/projects/*​/*.jsonl`, i.e. over EVERY project
+ * directory. Some hold material that must not be pulled into an unrelated context: work
+ * under NDA, medical or legal notes, anything personal. The boundary is not reading, it is
+ * CONTENT EGRESS. An aggregate is safe (totals, rates, durations, per-day counts); an
+ * excerpt is not (snippets, quotes, first-line previews, top-K words).
+ *
+ * WHY: context is what the assistant IS at a given moment, so pulling raw material from one
+ * zone into another is a blend, not a copy. The human analogue is not recall — recall
+ * arrives tagged as memory, attenuated, self-model intact. A raw transcript arrives
+ * untagged, verbatim, in the same modality as the live conversation. That is replay.
+ *
+ * Hence: NARRATED may cross a threshold, RAW may not. A curated first-person account is the
+ * assistant's analogue of memory and may cross (`narratedExempt`); a raw record may not.
+ *
+ * OPT-IN, THEN FAIL SAFE (v3, after review):
+ *   - No register file at all      → the feature is OFF. Nothing is declared, nothing is
+ *                                    withheld. A user who never configures zones is not
+ *                                    silently locked out of their own archive.
+ *   - Register present but broken  → FAIL CLOSED. Everything classifies private and the
+ *                                    guard blocks; a declared intent must never degrade
+ *                                    into silence.
+ *   - Register present and valid   → declared zones apply; unregistered project dirs are
+ *                                    quote-closed, count-open.
+ *
+ * The list lives in `LIFEOS/USER/CONFIG/private-zones.json` (USER zone: a payload sync never
+ * overwrites it, and no personal path is ever carried in SYSTEM code). This module and
+ * `hooks/PrivateZoneEgressGuard.hook.ts` read the same register.
+ *
+ * STATUS: the narrated/raw rule was derived in one session (2026-09-05) and has not been
+ * tested against a second case. Best available rule, not a settled one.
+ */
+
+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+const HOME = process.env.HOME ?? homedir();
+// Every neighbouring tool resolves the config root this way; hardcoding ~/.claude made a
+// CLAUDE_CONFIG_DIR install read no register at all, i.e. the control was silently off —
+// the one failure mode this module's own doc forbids.
+const CONFIG_ROOT = process.env.CLAUDE_CONFIG_DIR || join(HOME, ".claude");
+export const REGISTER_PATH = join(CONFIG_ROOT, "LIFEOS/USER/CONFIG/private-zones.json");
+export const PROJECTS_DIR = join(CONFIG_ROOT, "projects");
+export const PRIVATE_BUCKET = "private";
+
+export interface ZoneRule { match: string; why?: string; since?: string }
+export type RegisterState = "absent" | "valid" | "broken";
+export interface Register {
+  state: RegisterState;
+  private: ZoneRule[];
+  public: ZoneRule[];
+  narratedExempt: ZoneRule[];
+}
+
+const okRules = (v: unknown): v is ZoneRule[] =>
+  Array.isArray(v) && v.every((r) => r && typeof r === "object" && typeof (r as ZoneRule).match === "string" && (r as ZoneRule).match.length > 0);
+
+// An archive sweep classifies thousands of paths; without a cache each one re-read and
+// re-parsed the register. Keyed on path + CONTENT HASH: mtime and size are preserved by
+// `cp -p`, `rsync -t` and `tar -x`, so a restore used to serve the pre-restore verdict.
+let cache: { key: string; reg: Register } | null = null;
+
+export function loadRegister(path: string = REGISTER_PATH): Register {
+  if (!existsSync(path)) return { state: "absent", private: [], public: [], narratedExempt: [] };
+  let key = path;
+  // mtime alone is not identity: `cp -p`, `rsync -t` and `tar -x` preserve it to the
+  // nanosecond, so a restore served the pre-restore verdict. Size and inode break that tie.
+  // Content hash, not stat: an in-place rewrite that preserves mtime AND length (cp -p over
+  // a same-size file, or a one-character edit plus `touch -r`) served the old verdict.
+  let body = "";
+  try { body = readFileSync(path, "utf8"); key = `${path}:${Bun.hash(body)}`; }
+  catch { /* fall through to a fresh read */ }
+  if (cache?.key === key) return cache.reg;
+  try {
+    const raw = JSON.parse(body || readFileSync(path, "utf8"));
+    // A file that parses but declares none of the three keys is a typo, not a configuration:
+    // `{"privateZones": […]}` used to read as valid-with-zero-rules and protect nothing.
+    if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("not an object");
+    if (!("private" in raw) && !("public" in raw) && !("narratedExempt" in raw)) throw new Error("no rule keys");
+    // `?? []` turned an explicit null into a valid register protecting nothing, which is the
+    // same "parses but protects nothing" state the key check above closes.
+    const pick = (k: string) => (k in raw ? raw[k] : []);
+    const priv = pick("private"), pub = pick("public"), nar = pick("narratedExempt");
+    if (!okRules(priv) || !okRules(pub) || !okRules(nar)) throw new Error("malformed rule array");
+    const reg: Register = { state: "valid", private: priv, public: pub, narratedExempt: nar };
+    cache = { key, reg };
+    return reg;
+  } catch {
+    const reg: Register = { state: "broken", private: [], public: [], narratedExempt: [] };
+    cache = { key, reg };
+    return reg;
+  }
+}
+
+/** `"/vault/"` and `"/vault"` name the same directory. Shared by the library and the guard. */
+export function matchesRule(t: string, match: string): boolean {
+  const bare = match.replace(/\/+$/, "");
+  // The third disjunct is the directory ITSELF with no trailing slash: without it a rule
+  // written `proj-vault/` left its own directory "unregistered", and the triage CLI — whose
+  // whole job is printing names — printed a declared zone's name.
+  // The suffix must not double the separator: for a root-anchored rule ("/vault/") the naive
+  // `/${bare}` builds "//vault", so the zone DIRECTORY itself matched nothing — only paths
+  // strictly inside it did, and both lanes let the directory be read whole.
+  const suffix = bare.startsWith("/") ? bare : `/${bare}`;
+  // `t === bare` was unreachable: every caller passes a resolved absolute path, for which
+  // endsWith already answers. Deleted rather than tested.
+  return t.includes(match) || t.endsWith(suffix);
+}
+
+export type Classification = "private" | "public" | "unregistered";
+
+/**
+ * Order is load-bearing and is the whole safety argument:
+ *   1. broken register  → private (fail closed)
+ *   2. absent register  → public  (feature off; nothing declared)
+ *   3. narratedExempt   → public  (a narrated artifact may cross even from inside a zone;
+ *                                  what blends zones is the RAW record, not an account of it)
+ *   4. private rule     → private (wins over any public rule, whatever their lengths)
+ *   5. public rule      → public
+ *   6. otherwise        → unregistered (quote-closed, count-open)
+ * Rule 4 exists because the first draft ranked by longest match and a test knocked it down:
+ * a longer PUBLIC pattern beat a shorter PRIVATE one on a path inside the private zone.
+ */
+export function classify(pathOrDir: string, reg: Register = loadRegister()): Classification {
+  if (reg.state === "broken") return "private";
+  if (reg.state === "absent") return "public";
+  // endsWith, not includes: the hook learned this a pass earlier and the library did not,
+  // so `HANDOFF.md.rawtranscript.jsonl` classified public while the guard blocked it. Every
+  // probe using splitBySensitivity/safeExcerpt would have quoted it out.
+  if (reg.narratedExempt.some((r) => pathOrDir.endsWith(r.match))) return "public";
+  // matchesRule, not includes: a rule written with a trailing slash otherwise left its own
+  // directory "unregistered", and --unregistered then printed a declared zone by name.
+  if (reg.private.some((r) => matchesRule(pathOrDir, r.match))) return "private";
+  // matchesRule here too: the private branch was fixed for trailing slashes a pass earlier
+  // and this one was not, so a declared PUBLIC directory read as unregistered.
+  if (reg.public.some((r) => matchesRule(pathOrDir, r.match))) return "public";
+  return "unregistered";
+}
+
+export function isQuotable(pathOrDir: string, reg?: Register): boolean {
+  return classify(pathOrDir, reg) === "public";
+}
+/** Everything is countable: aggregates never lose rows. */
+export function isCountable(_pathOrDir: string): boolean { return true; }
+export function isPrivate(pathOrDir: string, reg?: Register): boolean {
+  return classify(pathOrDir, reg) === "private";
+}
+
+export function splitBySensitivity(paths: string[], reg?: Register): { quotable: string[]; countableOnly: string[] } {
+  const quotable: string[] = [], countableOnly: string[] = [];
+  for (const p of paths) (isQuotable(p, reg) ? quotable : countableOnly).push(p);
+  return { quotable, countableOnly };
+}
+
+/** A row label is data too: non-quotable zones collapse into one unlabelled bucket. */
+export function bucketLabel(dir: string, reg?: Register): string {
+  return isQuotable(dir, reg) ? dir : PRIVATE_BUCKET;
+}
+
+export function assertQuotable(pathOrDir: string, reg?: Register): void {
+  if (!isQuotable(pathOrDir, reg)) {
+    throw new Error(
+      `PrivateZones: text egress from a ${classify(pathOrDir, reg)} zone is refused (${pathOrDir}). ` +
+        `Zones are counted, never quoted — use a coarse aggregate.`,
+    );
+  }
+}
+
+export function safeExcerpt<T>(pathOrDir: string, make: () => T, reg?: Register): T | null {
+  return isQuotable(pathOrDir, reg) ? make() : null;
+}
+
+/** A narrow aggregate is an excerpt in disguise: a per-dir breakdown reveals the zone label. */
+export type AggregateAxis = "total" | "per-day" | "per-dir";
+export function assertCoarseAggregate(pathOrDir: string, axis: AggregateAxis, reg?: Register): void {
+  if (!isQuotable(pathOrDir, reg) && axis === "per-dir") {
+    throw new Error(`PrivateZones: a per-dir breakdown reveals the zone label (${pathOrDir}). Use bucketLabel().`);
+  }
+}
+
+/**
+ * Only meaningful for a VALID register: a broken one classifies everything private and an
+ * absent one classifies everything public, so both yield [] on their own. A state guard here
+ * would be dead code claiming to be a safety check — the CLI checks state before calling.
+ */
+/**
+ * Is a register declared while no hook is registered to enforce it?
+ *
+ * The registration ships in `USER/CONFIG/hooks.user.json`, which `ScaffoldUser` only
+ * copy-MISSES and payload-sync skips entirely, so an install that already has that file can
+ * never receive ours. A register would then exist with nothing behind it, and silence is the
+ * one failure this module forbids — so the triage CLI says it out loud, and it reads the
+ * COMPOSED settings rather than the delivery path it is complaining about.
+ */
+export function wiringWarning(): string | null {
+  if (loadRegister().state === "absent") return null;
+  const root = process.env.CLAUDE_CONFIG_DIR || join(process.env.HOME ?? homedir(), ".claude");
+  try {
+    const settings = readFileSync(join(root, "settings.json"), "utf8");
+    // The Read/Grep/Glob matcher specifically: a settings file that registers the hook under
+    // some OTHER matcher is exactly the half-wired state this is meant to catch.
+    if (/"matcher"\s*:\s*"[^"]*Read[^"]*"[\s\S]{0,400}?PrivateZoneEgressGuard/.test(settings)) return null;
+  } catch { /* unreadable settings: warn rather than assume */ }
+  return `A register is declared but no PreToolUse entry runs PrivateZoneEgressGuard.
+  Zone enforcement is OFF. Add it to ${join(root, "LIFEOS/USER/CONFIG/hooks.user.json")}:
+    { "hooks": { "PreToolUse": [
+        { "matcher": "Read|Grep|Glob", "hooks": [{ "type": "command",
+          "command": "$HOME/.claude/hooks/PrivateZoneEgressGuard.hook.ts" }] } ] } }
+  It takes effect at the next session start, when MergeSettings composes the overlay.`;
+}
+
+export function unregistered(projectsDir: string = PROJECTS_DIR, reg: Register = loadRegister()): string[] {
+  let dirs: string[] = [];
+  try { dirs = readdirSync(projectsDir, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name); }
+  catch { return []; }
+  // Full paths, as every other caller passes: a slash-bearing rule can never match a bare
+  // directory NAME, so the triage CLI was printing declared zones by name.
+  return dirs.filter((d) => classify(`${projectsDir}/${d}`, reg) === "unregistered").sort();
+}
+
+if (import.meta.main) {
+  if (process.argv.includes("--unregistered")) {
+    const warn = wiringWarning();
+    if (warn) {
+      // Non-zero: a gate reading only the exit code used to see green while enforcement was
+      // off, which is the same silence this whole check exists to break.
+      console.error(`⚠️  ${warn}\n`);
+      process.exit(3);
+    }
+    const reg = loadRegister();
+    // An all-clear must never be printable when the register is unusable: a broken file and
+    // an empty triage list produce the same zero-length array, so state is reported first.
+    if (reg.state === "broken") {
+      console.error(`❌ Register unusable (parse or shape error): ${REGISTER_PATH}\n   Failing closed: every path classifies private until it is fixed.`);
+      process.exit(2);
+    }
+    if (reg.state === "absent") {
+      console.log(`ℹ️  No register at ${REGISTER_PATH} — zone classification is OFF. Copy private-zones.example.json to start.`);
+      process.exit(0);
+    }
+    const list = unregistered(PROJECTS_DIR, reg);
+    if (list.length === 0) { console.log("✅ Every project directory is classified."); process.exit(0); }
+    console.log(`⚠️  ${list.length} unclassified director${list.length === 1 ? "y" : "ies"} (quote-closed, count-open):\n`);
+    for (const d of list) console.log(`  ${d}`);
+    console.log(`\nClassify them in ${REGISTER_PATH}`);
+    process.exit(1);
+  }
+  console.log("usage: PrivateZones.ts --unregistered");
+}
