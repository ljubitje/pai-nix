+#!/usr/bin/env bun
+/**
+ * @version 4.0.0
+ * PrivateZoneEgressGuard.hook.ts — PreToolUse lane for private zones (Read/Grep/Glob).
+ *
+ * INVARIANT: private zones are COUNTED, never QUOTED. A declared zone's raw content must not
+ * enter the context of an unrelated session; a NARRATED account of it may.
+ *
+ * WHY THIS FILE IS SMALL AGAIN (v4, Klemen's cut after 27 review rounds).
+ * v3 also guarded Bash. Twenty-five of those rounds were spent on that one lane, because it
+ * had to decide, from the TEXT of an arbitrary shell command, what the command would read.
+ * Every fix opened a new spelling: quotes, `sh -c`, a two-step `cd`, `*`, `?`, `[st]`,
+ * `{t,x}`, wrapper words, redirections, and a `mkdir` decoy that forged the own-room grant.
+ * That is not a sequence of bugs, it is a property of parsing shell, and it twice broke real
+ * work with false positives.
+ *
+ * So the Bash lane is gone. What remains is the half that was always sound:
+ *
+ *   STRUCTURED TOOLS — the path is a FIELD, not a shell string. Classify it and refuse
+ *   anything not quotable. No tokenising, no verb lists, no glob semantics.
+ *
+ *   THE LIBRARY — `LIFEOS/TOOLS/PrivateZones.ts` is what archive probes call
+ *   (splitBySensitivity, bucketLabel). The threat that started this was a probe of mine
+ *   printing examples from every project directory, and that is exactly what the library
+ *   answers. It is the protection; this hook is the backstop on the tool I reach for most.
+ *
+ * WHAT IS DELIBERATELY NOT COVERED: a shell command. `cat <zone>/x` is not refused. Stated
+ * plainly rather than half-guarded, because a half-guard reads as a promise.
+ *
+ * Fail policy: fail-OPEN on an internal error (a bug in a guard must not wedge a tool);
+ * fail-CLOSED on a register that exists and is unusable; silent when no register exists.
+ */
+
+import { existsSync, realpathSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { createRequire } from "node:module";
+import { resolve } from "node:path";
+
+type PZ = typeof import("../LIFEOS/TOOLS/PrivateZones");
+type Register = ReturnType<PZ["loadRegister"]>;
+
+/**
+ * The library is resolved LAZILY and in isolation. A top-level import made this the first
+ * hook to reach out of `hooks/`, and a missing file then killed the whole dispatcher — every
+ * PreToolUse guard that predates this one went silent with it. A new control must never be
+ * able to switch off the controls it joins.
+ */
+let pz: PZ | null | undefined;
+function lib(): PZ | null {
+  if (pz !== undefined) return pz;
+  const req = createRequire(import.meta.url);
+  for (const spec of ["../LIFEOS/TOOLS/PrivateZones.ts", "../LIFEOS/TOOLS/PrivateZones"]) {
+    try { pz = req(spec) as PZ; return pz; } catch { /* try the next spelling */ }
+  }
+  pz = null;
+  // Silence is the one failure this module forbids: say so when a register exists.
+  try {
+    if (existsSync(registerPath())) {
+      console.error("[PrivateZoneEgressGuard] LIFEOS/TOOLS/PrivateZones.ts is missing; zone enforcement is OFF while a register exists.");
+    }
+  } catch { /* diagnostics must never throw */ }
+  return pz;
+}
+
+/** The register path, derivable without the library so the off-switch costs nothing. */
+function registerPath(): string {
+  const root = process.env.CLAUDE_CONFIG_DIR || `${process.env.HOME ?? homedir()}/.claude`;
+  return `${root}/LIFEOS/USER/CONFIG/private-zones.json`;
+}
+
+/** Symlinks are paths too: a link into a zone reaches the zone. */
+function realish(p: string): string {
+  try { return realpathSync.native(p); } catch { return p; }
+}
+
+/** True only for a regular file. A directory wearing the name is not the narrative. */
+function isFile(p: string): boolean {
+  try { return statSync(p).isFile(); } catch { return false; }
+}
+
+interface HookInput { tool_name?: string; cwd?: string; tool_input?: Record<string, unknown> }
+
+/**
+ * Root-shaped fields only, plus a pattern that is itself a path. A Grep `pattern` is a
+ * content filter, not a root, so a bare regex never counts.
+ */
+function pathFields(input: Record<string, unknown> | undefined): string[] {
+  const out: string[] = [];
+  for (const [k, v] of Object.entries(input ?? {})) {
+    if (typeof v !== "string") continue;
+    if (/(^|_)(path|dir|file)s?$/i.test(k)) out.push(v);
+    // A pattern counts when it carries a PATH separator: requiring a leading `/`, `~` or
+    // `./` let `Glob{pattern:"<zone>/**"}` read the zone while `./<zone>/**` was refused, and
+    // resolving every pattern turned a bare content regex equal to a zone name into a block.
+    else if (/^(pattern|glob)$/i.test(k) && v.includes("/")) out.push(v);
+  }
+  return out;
+}
+
+export function check(input: HookInput, reg?: Register): { block: true; message: string } | null {
+  try {
+    if (!reg && !existsSync(registerPath())) return null; // opt-in, and off is free
+    const tool = input?.tool_name ?? "";
+    if (!/^(Read|Grep|Glob|NotebookRead)$/.test(tool)) return null; // Bash is not ours (v4)
+
+    const L = lib();
+    if (!L) return null;
+    const register = reg ?? L.loadRegister();
+    if (register.state === "absent") return null;
+
+    const HOME = process.env.HOME ?? homedir();
+    const cwd = typeof input?.cwd === "string" ? input.cwd : "";
+    // Both spellings of every field: tokens were resolved while rules were not, so a symlink
+    // anywhere in the path used to switch an absolute rule off.
+    const fields = pathFields(input?.tool_input).flatMap((f) => {
+      const lit = resolve(cwd || HOME, f.replace(/^~(?=\/|$)/, HOME));
+      const real = realish(lit);
+      return real === lit ? [lit] : [lit, real];
+    });
+
+    if (register.state === "broken") {
+      // Closed means closed: a pathless Grep/Glob is a RECURSIVE read from cwd, and letting
+      // it through at the one moment nothing is known was the weakest possible reading of
+      // fail-closed. The repair loop stays open.
+      if (fields.length > 0 &&
+          fields.every((f) => f === L.REGISTER_PATH || f.endsWith("private-zones.json"))) return null;
+      return blocked("register unusable", tool, "the register exists but could not be parsed; failing closed");
+    }
+    if (fields.length === 0) return null;
+
+    /**
+     * The own room is a CONCRETE directory, not the rule text: keying the grant on the rule
+     * turned one `mkdir -p /tmp/decoy/<rule> && cd` into a key for the real zone. The root is
+     * the SHORTEST prefix of cwd satisfying the rule, in both spellings.
+     */
+    const inZone = (p: string, m: string): boolean => {
+      const bare = m.replace(/\/+$/, "");
+      const seg = bare.startsWith("/") ? `${bare}/` : `/${bare}/`;
+      return `${p.replace(/\/+$/, "")}/`.includes(seg) || p === bare;
+    };
+    const zoneRootOf = (p: string, m: string): string | null => {
+      const parts = p.split("/");
+      for (let i = 2; i <= parts.length; i++) {
+        const cand = parts.slice(0, i).join("/");
+        if (inZone(cand, m)) return cand;
+      }
+      return null;
+    };
+    const cwdZones: string[] = [];
+    if (cwd) {
+      for (const r of register.private) {
+        for (const c of [resolve(cwd), realish(resolve(cwd))]) {
+          const root = zoneRootOf(c, r.match);
+          if (root) for (const form of [root, realish(root)]) if (!cwdZones.includes(form)) cwdZones.push(form);
+        }
+      }
+    }
+    const inOwnRoom = (t: string) => cwdZones.some((z) => t === z || t.startsWith(`${z}/`));
+
+    for (const f of fields) {
+      if (inOwnRoom(f)) continue;                                    // the room reads itself
+      // A FILE, not merely a matching name: `mkdir <zone>/HANDOFF.md` exempted the whole
+      // subtree below it, which is the same forgeable-capability shape the own-room grant was
+      // hardened against. A narrated artifact is a document, so it must be one on disk.
+      if (register.narratedExempt.some((r) => f.endsWith(r.match)) && isFile(f)) continue;
+      if (register.private.some((r) => L.matchesRule(f, r.match))) {
+        return blocked(register.private.find((r) => L.matchesRule(f, r.match))?.match ?? "private zone", tool, undefined, f);
+      }
+      // The quote-closed default for project directories nobody has triaged yet.
+      if (underProjects(f, L) && classifyEither(f, register, L) === "unregistered") {
+        return blocked("unclassified project directory", tool, "not yet triaged; quote-closed by default", f);
+      }
+    }
+    return null;
+  } catch { return null; }
+}
+
+/** One question, both spellings: `underProjects` resolves, so `classify` must be asked both. */
+function classifyEither(t: string, reg: Register, L: PZ): "private" | "public" | "unregistered" {
+  const a = L.classify(t, reg);
+  if (a !== "unregistered") return a;
+  const r = realish(t);
+  return r === t ? a : L.classify(r, reg);
+}
+
+function underProjects(t: string, L: PZ): boolean {
+  return t.startsWith(`${L.PROJECTS_DIR}/`) || realish(t).startsWith(`${realish(L.PROJECTS_DIR)}/`);
+}
+
+function blocked(zone: string, tool: string, why?: string, path?: string): { block: true; message: string } {
+  return {
+    block: true,
+    message: [
+      "",
+      "═══════════════════════════════════════════════════════════════════════════",
+      `  PrivateZoneEgressGuard — ${tool} into a private zone BLOCKED.`,
+      "═══════════════════════════════════════════════════════════════════════════",
+      "",
+      `  Zone:     ${zone}${why ? `  (${why})` : ""}`,
+      ...(path ? [`  Path:     ${path}`] : []),
+      "",
+      "  This call would pull raw private-zone content into the context of an",
+      "  unrelated session. Context is what the assistant IS at a given moment,",
+      "  so this is a blend, not merely a copy. Narrated accounts may cross;",
+      "  raw records may not.",
+      "",
+      "  Invariant: private zones are COUNTED, never QUOTED. To count a zone use",
+      "  LIFEOS/TOOLS/PrivateZones.ts (splitBySensitivity, bucketLabel): it counts",
+      "  every zone without ever naming one.",
+      "",
+      "  Register: LIFEOS/USER/CONFIG/private-zones.json",
+      "═══════════════════════════════════════════════════════════════════════════",
+      "",
+    ].join("\n"),
+  };
+}
+
+/** Standalone entry: stderr + exit 2 blocks, exit 0 allows, any internal failure allows. */
+if (import.meta.main) {
+  let input: HookInput = {};
+  try { input = JSON.parse(await Bun.stdin.text()); } catch { process.exit(0); }
+  try {
+    const res = check(input);
+    if (res?.block) { console.error(res.message); process.exit(2); }
+  } catch { /* fail open */ }
+  process.exit(0);
+}
