+/**
+ * lifeos-nix (f-inference-provider): the parsed TOML without the identity validation above,
+ * for sections whose consumers must not depend on [principal]/[da] being filled in
+ * (InferenceProvider reads [inference] here). null when the file does not exist; a TOML
+ * syntax error throws. Uncached on purpose: callers read once per launch or per call, and a
+ * hand edit of the file must take effect on the next read.
+ */
+/** lifeos-nix (f-inference-provider): the path loadRawLifeosConfig() reads by default, so a
+ * caller that must re-read the same file (e.g. after a parse error) never reads another one. */
+export function lifeosConfigPath(): string {
+  return process.env.LIFEOS_CONFIG_PATH ?? DEFAULT_CONFIG_PATH;
+}
+
+export function loadRawLifeosConfig(
+  opts: { path?: string } = {},
+): { raw: Record<string, any>; path: string } | null {
+  const path = opts.path ?? lifeosConfigPath();
+  if (!existsSync(path)) return null;
+  try {
+    delete require.cache[require.resolve(path)];
+  } catch {
+    // require.resolve can throw on first read; safe to ignore.
+  }
+  const raw = require(path) as unknown;
+  if (!raw || typeof raw !== "object") {
+    throw new Error(`LifeosConfig: ${path} did not parse to an object`);
+  }
+  return { raw: raw as Record<string, any>, path };
+}
+
 export function clearLifeosConfigCache(): void {
   cache = null;
 }
