+#!/usr/bin/env bun
+/**
+ * InferenceProvider.ts — which model server `claude` talks to, decided at every exec.
+ *
+ * lifeos-nix (f-inference-provider). The lifeos-nix `claude` wrapper runs `gate` (below)
+ * before every exec of the real binary, so every way of starting claude — the launcher,
+ * Inference.ts, Pulse, skills, a plain `claude` in a terminal — passes through one decision.
+ *
+ * Config: `[inference]` in LIFEOS/USER/CONFIG/LIFEOS_CONFIG.toml (USER zone; editing it by
+ * hand IS the switch):
+ *
+ *   [inference]
+ *   mode = "local-only"             # anthropic-only | local-with-fallback | local-only
+ *                                   # (default when [inference.local] is set: local-with-fallback)
+ *   [inference.local]
+ *   base_url  = "http://host:port"  # must speak Anthropic /v1/messages (OpenAI-only servers:
+ *                                   # put a translating proxy in front and point here)
+ *   model     = "some-model"        # default for every tier
+ *   token_env = "LOCAL_LLM_TOKEN"   # optional: env var holding the server's key
+ *   [inference.local.models]        # optional per-tier overrides
+ *   haiku = "small-model"
+ *
+ * Fail-closed rules:
+ *   - A present section with an unknown key or bad value THROWS (a typo must not pick a mode).
+ *   - A local-only process exports LIFEOS_INFERENCE_MODE=local-only; every descendant is
+ *     local-only no matter what it can or cannot read, and refuses if it cannot read the
+ *     local settings.
+ *   - local-only never fails over. local-with-fallback fails over only when explicitly asked
+ *     (LIFEOS_INFERENCE_TARGET=anthropic, set by Inference.ts) or when the server is down.
+ *
+ * CLI: `bun InferenceProvider.ts` prints the resolved config and local health;
+ *      `bun InferenceProvider.ts gate` prints shell code for the claude wrapper (see gate()).
+ */
+
+import { appendFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { homedir } from "node:os";
+import { loadRawLifeosConfig } from "./LifeosConfig";
+
+export const MODES = ["anthropic-only", "local-with-fallback", "local-only"] as const;
+export type InferenceMode = (typeof MODES)[number];
+
+export const TIERS = ["fable", "opus", "sonnet", "haiku"] as const;
+export type Tier = (typeof TIERS)[number];
+
+/** Exported into every local-only process; descendants inherit local-only from it. */
+export const MODE_MARKER = "LIFEOS_INFERENCE_MODE";
+/** Set by localEnv(); lets the Anthropic path strip exactly what localEnv added. */
+export const APPLIED_MARKER = "LIFEOS_INFERENCE_LOCAL";
+/** Optional per-spawn request: "local" | "anthropic" (Inference.ts uses it for fallback). */
+export const TARGET_HINT = "LIFEOS_INFERENCE_TARGET";
+/** LIFEOS_GATE=off bypasses the gate entirely (manual escape hatch, never set by code). */
+export const PLACEHOLDER_TOKEN = "lifeos-local-no-auth";
+
+/** Every variable localEnv() may set — removed again on the Anthropic path. */
+export const LOCAL_KEYS = [
+  "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_MODEL",
+  "ANTHROPIC_DEFAULT_FABLE_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
+  "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
+  "ANTHROPIC_SMALL_FAST_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL",
+  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "CLAUDE_CODE_DISABLE_WEB_FETCH",
+  "ENABLE_CLAUDEAI_MCP_SERVERS", APPLIED_MARKER,
+] as const;
+
+export interface LocalProvider {
+  baseUrl: string;
+  /** Resolved model per tier — every tier is filled (default `model` or override). */
+  models: Record<Tier, string>;
+  tokenEnv?: string;
+}
+
+export interface ProviderConfig {
+  mode: InferenceMode;
+  local?: LocalProvider;
+}
+
+export const ANTHROPIC_ONLY: ProviderConfig = { mode: "anthropic-only" };
+
+type Env = Record<string, string | undefined>;
+
+function rejectUnknown(table: Record<string, unknown>, allowed: readonly string[], name: string, where: string) {
+  for (const k of Object.keys(table)) {
+    if (!allowed.includes(k)) {
+      throw new Error(`[${name}] unknown key "${k}" in ${where} — allowed: ${allowed.join(", ")}`);
+    }
+  }
+}
+
+/** Pure: raw `[inference]` table → validated config. `where` names the file in errors. */
+export function resolveProviderConfig(raw: unknown, where = "LIFEOS_CONFIG.toml"): ProviderConfig {
+  if (raw === undefined || raw === null) return ANTHROPIC_ONLY;
+  if (typeof raw !== "object") throw new Error(`[inference] in ${where} must be a table`);
+  const t = raw as Record<string, any>;
+  rejectUnknown(t, ["mode", "local"], "inference", where);
+
+  const mode = t.mode ?? (t.local !== undefined ? "local-with-fallback" : "anthropic-only");
+  if (!(MODES as readonly string[]).includes(mode)) {
+    throw new Error(`[inference] mode = ${JSON.stringify(mode)} in ${where} — use ${MODES.join(" | ")}`);
+  }
+
+  const l = t.local;
+  if (mode === "anthropic-only" && l === undefined) return ANTHROPIC_ONLY;
+  if (!l || typeof l !== "object") {
+    throw new Error(`[inference] mode = "${mode}" needs an [inference.local] table in ${where}`);
+  }
+  rejectUnknown(l, ["base_url", "model", "models", "token_env"], "inference.local", where);
+  if (typeof l.base_url !== "string" || !/^https?:\/\/[^\s/]+/.test(l.base_url)) {
+    throw new Error(`[inference.local] base_url must be an http(s) URL in ${where}`);
+  }
+  const overrides = (l.models ?? {}) as Record<string, unknown>;
+  if (typeof overrides !== "object") throw new Error(`[inference.local.models] must be a table in ${where}`);
+  rejectUnknown(overrides, TIERS, "inference.local.models", where);
+  const models = {} as Record<Tier, string>;
+  for (const tier of TIERS) {
+    const m = overrides[tier] ?? l.model;
+    if (typeof m !== "string" || !m) {
+      throw new Error(`[inference.local] no model for tier "${tier}" in ${where} — set model = "…" or models.${tier}`);
+    }
+    models[tier] = m;
+  }
+  if (l.token_env !== undefined && (typeof l.token_env !== "string" || !l.token_env)) {
+    throw new Error(`[inference.local] token_env must be an env var name in ${where}`);
+  }
+  const local = { baseUrl: l.base_url.replace(/\/+$/, ""), models, tokenEnv: l.token_env };
+  // A validated local table under anthropic-only is kept out of the result on purpose.
+  return mode === "anthropic-only" ? ANTHROPIC_ONLY : { mode, local };
+}
+
+/**
+ * Read and validate the live config. Invalid → throws. No file → anthropic-only, UNLESS this
+ * process descends from a local-only one (marker in env): then it throws, because "I cannot
+ * see the config" must never turn into "go to Anthropic".
+ */
+export function loadProviderConfig(env: Env = process.env): ProviderConfig {
+  const sticky = env[MODE_MARKER] === "local-only";
+  const loaded = loadRawLifeosConfig();
+  if (!loaded) {
+    if (sticky) throw new Error(`${MODE_MARKER}=local-only is set but LIFEOS_CONFIG.toml is not readable — refusing`);
+    return ANTHROPIC_ONLY;
+  }
+  const cfg = resolveProviderConfig(loaded.raw.inference, loaded.path);
+  if (!sticky || cfg.mode === "local-only") return cfg;
+  if (!cfg.local) {
+    throw new Error(`${MODE_MARKER}=local-only is set but ${loaded.path} has no [inference.local] — refusing`);
+  }
+  return { mode: "local-only", local: cfg.local };
+}
+
+/** Tier of an alias or a pinned id ("opus", "claude-opus-5"); undefined if neither. */
+export function tierOf(model: string): Tier | undefined {
+  const m = model.toLowerCase().match(/(fable|opus|sonnet|haiku)/);
+  return m ? (m[1] as Tier) : undefined;
+}
+
+/** The local model name a requested Claude model maps to. Unknown → the opus mapping. */
+export function localModelFor(local: LocalProvider, model: string): string {
+  return local.models[tierOf(model) ?? "opus"];
+}
+
+/** The credential sent to the local server. Never empty: an empty AUTH_TOKEN would let the
+ * subscription OAuth token through (measured 2026-10-04). */
+export function localToken(local: LocalProvider, env: Env): string {
+  return (local.tokenEnv && env[local.tokenEnv]) || PLACEHOLDER_TOKEN;
+}
+
+/**
+ * Overlay the local target onto an env. ANTHROPIC_AUTH_TOKEN is ALWAYS set: it outranks the
+ * subscription OAuth credential, so the OAuth token can never be sent to the local server.
+ */
+export function localEnv(base: Env, cfg: ProviderConfig): Env {
+  if (!cfg.local) throw new Error("localEnv: no [inference.local] configured");
+  const { local } = cfg;
+  const env = { ...base };
+  delete env.ANTHROPIC_API_KEY;
+  env.ANTHROPIC_BASE_URL = local.baseUrl;
+  env.ANTHROPIC_AUTH_TOKEN = localToken(local, base);
+  env.ANTHROPIC_MODEL = local.models.fable; // session default = top rung, as on Anthropic
+  env.ANTHROPIC_DEFAULT_FABLE_MODEL = local.models.fable;
+  env.ANTHROPIC_DEFAULT_OPUS_MODEL = local.models.opus;
+  env.ANTHROPIC_DEFAULT_SONNET_MODEL = local.models.sonnet;
+  env.ANTHROPIC_DEFAULT_HAIKU_MODEL = local.models.haiku;
+  env.ANTHROPIC_SMALL_FAST_MODEL = local.models.haiku;
+  env.CLAUDE_CODE_SUBAGENT_MODEL = local.models.opus;
+  env[APPLIED_MARKER] = "1";
+  if (cfg.mode === "local-only") {
+    env[MODE_MARKER] = "local-only";
+    env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC = "1";
+    // WebFetch asks api.anthropic.com about every domain before fetching; NONESSENTIAL does
+    // not stop that (review 2026-10-04). Under local-only WebFetch is off.
+    env.CLAUDE_CODE_DISABLE_WEB_FETCH = "1";
+    env.ENABLE_CLAUDEAI_MCP_SERVERS = "false";
+  }
+  return env;
+}
+
+/** Remove what localEnv added (only when it did), so an Anthropic spawn from inside a local
+ * session does not carry local model names or the local URL. */
+export function anthropicEnv(base: Env): Env {
+  const env = { ...base };
+  if (env[APPLIED_MARKER]) for (const k of LOCAL_KEYS) delete env[k];
+  return env;
+}
+
+/** Is the local server answering? `GET {base}/v1/models` with the session's own credential. */
+export async function localHealthy(cfg: ProviderConfig, env: Env = process.env, timeoutMs = 2000): Promise<boolean> {
+  if (!cfg.local) return false;
+  const token = localToken(cfg.local, env);
+  try {
+    const res = await fetch(`${cfg.local.baseUrl}/v1/models`, {
+      headers: { authorization: `Bearer ${token}`, "x-api-key": token },
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
+
+/** Append a provider event (fallback, refusal, invalid config). Never throws. */
+export function recordProviderEvent(entry: Record<string, unknown>): void {
+  try {
+    const dir = join(homedir(), ".claude", "LIFEOS", "MEMORY", "OBSERVABILITY");
+    mkdirSync(dir, { recursive: true });
+    appendFileSync(
+      join(dir, "inference-provider.jsonl"),
+      JSON.stringify({ ts: new Date().toISOString(), ...entry }) + "\n",
+    );
+  } catch { /* observability must never break inference */ }
+}
+
+export type GateDecision =
+  | { action: "exec"; env: Env; notice?: string; event?: string }
+  | { action: "refuse"; reason: string };
+
+/**
+ * The decision for one exec of claude. Pure except for the health probe, which is injected.
+ *   anthropic-only      → Anthropic env.
+ *   local-only          → local env, always; no health check, no failover (a down server
+ *                         makes claude fail, which is the point). An anthropic hint refuses.
+ *   local-with-fallback → hint "local" → local env; hint "anthropic" → Anthropic env;
+ *                         no hint → local if healthy, else Anthropic with a notice.
+ */
+export async function decide(
+  env: Env,
+  load: () => ProviderConfig,
+  healthy: (cfg: ProviderConfig, env: Env) => Promise<boolean>,
+): Promise<GateDecision> {
+  let cfg: ProviderConfig;
+  try {
+    cfg = load();
+  } catch (e) {
+    return { action: "refuse", reason: `inference config invalid: ${(e as Error).message}` };
+  }
+  const hint = env[TARGET_HINT];
+  if (hint !== undefined && hint !== "local" && hint !== "anthropic") {
+    return { action: "refuse", reason: `${TARGET_HINT}=${hint} — use local | anthropic` };
+  }
+  const clean = { ...env };
+  delete clean[TARGET_HINT];
+
+  if (cfg.mode === "anthropic-only") return { action: "exec", env: anthropicEnv(clean) };
+  if (cfg.mode === "local-only") {
+    if (hint === "anthropic") return { action: "refuse", reason: "inference mode is local-only — Anthropic is not allowed" };
+    return { action: "exec", env: localEnv(clean, cfg) };
+  }
+  if (hint === "anthropic") return { action: "exec", env: anthropicEnv(clean) };
+  if (hint === "local") return { action: "exec", env: localEnv(clean, cfg) };
+  if (await healthy(cfg, clean)) return { action: "exec", env: localEnv(clean, cfg) };
+  return {
+    action: "exec",
+    env: anthropicEnv(clean),
+    notice: `inference: ${cfg.local!.baseUrl} is not answering — this claude runs on Anthropic (fallback)`,
+    event: "fallback",
+  };
+}
+
+const SAFE_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
+const shq = (v: string) => `'${v.replace(/'/g, `'\\''`)}'`;
+
+/** Shell code that turns `before` into `after` (unset + export), for `eval` in the wrapper. */
+export function envDiffShell(before: Env, after: Env): string {
+  const out: string[] = [];
+  for (const k of Object.keys(before)) {
+    if (after[k] === undefined && SAFE_NAME.test(k)) out.push(`unset ${k}`);
+  }
+  for (const [k, v] of Object.entries(after)) {
+    if (v !== undefined && before[k] !== v && SAFE_NAME.test(k)) out.push(`export ${k}=${shq(v)}`);
+  }
+  return out.join("\n");
+}
+
+/**
+ * `gate` subcommand, for the claude wrapper: prints shell code and exits 0, or prints the
+ * reason on stderr and exits 3. The wrapper refuses to exec on any non-zero exit, so a crash
+ * here is a refusal too.
+ */
+async function gate(): Promise<never> {
+  const env = process.env as Env;
+  const d = await decide(env, () => loadProviderConfig(env), localHealthy);
+  if (d.action === "refuse") {
+    recordProviderEvent({ event: "refused", surface: "gate", reason: d.reason });
+    console.error(`❌ ${d.reason}`);
+    console.error(`   Fix [inference] in LIFEOS/USER/CONFIG/LIFEOS_CONFIG.toml (LIFEOS_GATE=off bypasses the gate).`);
+    process.exit(3);
+  }
+  if (d.notice) console.error(`⚠️  ${d.notice}`);
+  if (d.event) recordProviderEvent({ event: d.event, surface: "gate" });
+  process.stdout.write(envDiffShell(env, d.env) + "\n");
+  process.exit(0);
+}
+
+if (import.meta.main) {
+  if (process.argv[2] === "gate") {
+    try {
+      await gate();
+    } catch (e) {
+      console.error(`❌ inference gate crashed: ${(e as Error).message}`);
+      process.exit(3);
+    }
+  }
+  try {
+    const cfg = loadProviderConfig();
+    const healthy = cfg.local ? await localHealthy(cfg) : undefined;
+    console.log(JSON.stringify({ ...cfg, localHealthy: healthy }, null, 2));
+  } catch (e) {
+    console.error((e as Error).message);
+    process.exit(1);
+  }
+}
