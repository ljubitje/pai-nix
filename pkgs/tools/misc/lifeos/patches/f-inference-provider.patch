+/**
+ * lifeos-nix (f-inference-provider): choose the model server for a `claude` spawn from
+ * [inference] in LIFEOS_CONFIG.toml. `env` is the caller's existing Anthropic env and is
+ * returned untouched for anthropic-only (also: no section, no file). The choice is made once
+ * per launch — switching providers means editing the file and starting a new session.
+ */
+async function withInferenceProvider(
+  env: Record<string, string | undefined>,
+  surface: string,
+): Promise<Record<string, string | undefined>> {
+  let cfg;
+  try {
+    cfg = loadProviderConfig();
+  } catch (e) {
+    recordProviderEvent({ event: "config-invalid", surface, error: (e as Error).message });
+    error(`inference config invalid, refusing to start: ${(e as Error).message}`);
+  }
+  if (cfg.mode === "anthropic-only") return env;
+  const base = cfg.local!.baseUrl;
+  if (await localHealthy(cfg)) {
+    console.error(`🧠 inference: local (${base}, mode=${cfg.mode})`);
+    return localEnv(env, cfg);
+  }
+  if (cfg.mode === "local-only") {
+    recordProviderEvent({ event: "refused", surface, base_url: base });
+    error(
+      `inference mode is local-only and ${base} is not answering — refusing to start.\n` +
+        `   Bring the server up, or switch [inference] mode in LIFEOS/USER/CONFIG/LIFEOS_CONFIG.toml.`,
+    );
+  }
+  recordProviderEvent({ event: "fallback", surface, base_url: base });
+  console.error(`⚠️  inference: ${base} is not answering — this session runs on Anthropic (fallback)`);
+  return env;
+}
